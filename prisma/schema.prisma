// TripFlow database schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (managed by Better Auth — field names follow its conventions)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  memberships        TripMember[]
  createdActivities  Activity[]
  createdInvitations TripInvitation[]
  createdExpenses    Expense[]
  activityVotes      ActivityVote[]
  activityComments   ActivityComment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Trip planning domain
// ---------------------------------------------------------------------------

model Trip {
  id          String   @id @default(cuid())
  name        String
  destination String
  description String?
  /// Calendar dates (no time / timezone).
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  /// ISO 4217 code used for every amount of the trip (no conversions).
  currency    String   @default("ARS")
  /// Optional total budget, in hundredths of `currency`.
  budgetCents BigInt?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TripMember[]
  activities  Activity[]
  invitations TripInvitation[]
  expenses    Expense[]

  @@map("trip")
}

enum TripRole {
  OWNER
  EDITOR
}

model TripMember {
  tripId   String
  userId   String
  role     TripRole @default(EDITOR)
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@index([userId])
  @@map("trip_member")
}

/// Shareable invite link. Regenerating a link replaces the previous one.
model TripInvitation {
  id          String   @id @default(cuid())
  tripId      String
  token       String   @unique
  createdById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_invitation")
}

enum ActivityCategory {
  SIGHTSEEING
  FOOD
  EXCURSION
  ACCOMMODATION
  TRANSPORT
  SHOPPING
  NIGHTLIFE
  OTHER
}

/// An activity belongs to a trip. When `date` is null it lives in the
/// "ideas" board; otherwise it is scheduled in the itinerary for that day.
model Activity {
  id          String           @id @default(cuid())
  tripId      String
  title       String
  category    ActivityCategory @default(OTHER)
  notes       String?
  location    String?
  /// Coordinates of `location`, when it was picked from the place search.
  latitude    Float?
  longitude   Float?
  url         String?
  date        DateTime?        @db.Date
  /// "HH:mm" local time, optional.
  startTime   String?
  /// Order inside its day (or inside the ideas board).
  position    Int
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  trip      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expenses  Expense[]
  votes     ActivityVote[]
  comments  ActivityComment[]

  @@index([tripId, date, position])
  @@map("activity")
}

enum ExpenseCategory {
  ACCOMMODATION
  TRANSPORT
  FOOD
  ACTIVITIES
  SHOPPING
  OTHER
}

/// An estimated cost of the trip. It can be linked to an activity (e.g. the
/// entrance to a museum) or stand on its own (flights, hotel…).
model Expense {
  id          String          @id @default(cuid())
  tripId      String
  description String
  category    ExpenseCategory
  /// Always in hundredths of the trip's currency (integer: no rounding errors).
  amountCents BigInt
  /// If the activity is deleted the cost is kept, unlinked, so no money silently disappears.
  activityId  String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activity  Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([activityId])
  @@map("expense")
}

/// "I'd like to do this": one vote per member and idea. The composite key
/// makes voting twice impossible, even with concurrent requests.
model ActivityVote {
  activityId String
  userId     String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityId, userId])
  @@map("activity_vote")
}

/// A message in an activity's conversation ("¿reservamos?", "cierra los lunes").
model ActivityComment {
  id         String   @id @default(cuid())
  activityId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
  @@map("activity_comment")
}
