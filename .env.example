# PostgreSQL (see docker-compose.yml)
DATABASE_URL="postgresql://tripflow:tripflow@localhost:5433/tripflow?schema=public"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Photon geocoding API used by the place search (defaults to the public instance)
# PHOTON_URL="https://photon.komoot.io/api/"
